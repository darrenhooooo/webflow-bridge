{
  "manifest_version": 3,
  "name": "Webflow Bridge",
  "version": "0.4.0",
  "description": "Local browser-automation bridge: evaluate JS / send CDP on your active tab from a local daemon. Runs 100% locally on Chrome & Edge.",
  "permissions": ["scripting", "activeTab", "tabs", "debugger", "alarms", "tabGroups"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Webflow Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
