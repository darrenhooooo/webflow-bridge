{
  "manifest_version": 2,
  "name": "Webflow Bridge (Firefox 控制面板)",
  "version": "1.5.0",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "webflow-bridge@yctech.com.cn",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*",
  "browser_action": {
    "default_title": "Webflow Bridge 控制面板",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
